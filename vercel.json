{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/check-inactive",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/log-market-history",
      "schedule": "0 22 * * *"
    }
  ]
}
